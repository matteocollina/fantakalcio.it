# URL pubblico usato per canonical, sitemap, RSS e anteprime social.
# In produzione Vercel può ricavarlo automaticamente; impostarlo rende
# esplicito il dominio definitivo anche negli altri ambienti.
SITE_URL=https://fantakalcio.it

# Credenziale richiesta da `npm run generate:youtube-posts`.
# Inserire i valori reali solo in `.env.local` o nelle variabili Vercel.
OPENAI_API_KEY=

# Configurazione facoltativa del generatore di notizie.
OPENAI_MODEL=gpt-5.2
# `npm run setup:ytscribe` prepara repository e virtual environment.
YTSCRIBE_PYTHON=.venv-ytscribe/bin/python
YTSCRIBE_SCRIPT_PATH=.ytscribe/scripts/ytscribe.py
YTSCRIBE_LANG=it
YOUTUBE_MAX_VIDEOS_PER_CHANNEL=5
YOUTUBE_MAX_SOURCES_PER_RUN=12
YOUTUBE_LOOKBACK_HOURS=36

# Fonte usata per grafia, ruolo classico e squadra dei calciatori.
PLAYER_QUOTES_URL=https://www.fantacalcio.it/quotazioni-fantacalcio

# Fonte autorevole per disponibilità, infortuni e tempi di recupero.
INJURIES_URL=https://www.fantacalcio.it/infortunati-serie-a

# Alternativa pubblica a SITE_URL, utile solo se il dominio deve essere
# letto anche da componenti client. Non è necessaria nella configurazione attuale.
# NEXT_PUBLIC_SITE_URL=https://fantakalcio.it
